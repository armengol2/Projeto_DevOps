# Copie para .env.smtp e configure o destinatario desejado.
# No MailHog, mensagens sao capturadas localmente, sem entrega externa.
NOTIFY_EMAIL=destinatario@example.test
SMTP_FROM=jenkins@example.test
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_SECURITY=none
SMTP_TIMEOUT=10
SMTP_USERNAME=
SMTP_PASSWORD=
